# DOMAIN comes from .env (for example herhandmade.org). With DOMAIN=localhost Caddy makes a
# local certificate: the browser shows a warning once, which is fine for testing.
{$DOMAIN:localhost} {
	encode zstd gzip

	handle /api/* {
		request_body {
			max_size 8MB
		}
		reverse_proxy api:5000
	}

	# Everything else is the React app. Unknown paths fall back to index.html (React Router).
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
