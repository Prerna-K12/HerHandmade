# Copy this file to .env and fill it in. See help.md, section "Getting your .env ready".

PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/herhandmade
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters

# false on your laptop (http), true on the live server (https)
COOKIE_SECURE=false

# Where the React app runs. Used for CORS and for links in emails.
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173

# Where uploaded photos are stored
UPLOAD_DIR=./uploads

# First admin account (created by `npm run seed`)
SEED_ADMIN_NAME=NGO Admin
SEED_ADMIN_PHONE=9000000001
SEED_ADMIN_PASSWORD=admin12345

# Email. Leave SMTP_HOST empty in development: emails are printed in the terminal instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HerHandmade <no-reply@example.com>

# Shown to businesses on the tracking page
NGO_NAME=HerHandmade
NGO_EMAIL=hello@example.com
NGO_PHONE=+91-9000000000
