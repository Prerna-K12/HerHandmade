# For `docker compose` on the server. Copy to .env and fill in. See help.md, "Getting your .env ready".

# Your domain name (must point to the server). Use "localhost" to test on your own computer.
DOMAIN=localhost
# The full web address people use. Used for CORS and for the links in emails.
PUBLIC_BASE_URL=https://localhost

# Choose a long password for the database (letters and numbers only).
POSTGRES_PASSWORD=change-me
# A long random secret. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters
COOKIE_SECURE=true

# First admin (created by `docker compose exec api node scripts/seed.js`)
SEED_ADMIN_NAME=NGO Admin
SEED_ADMIN_PHONE=9000000001
SEED_ADMIN_PASSWORD=choose-a-strong-password

# Email (leave SMTP_HOST empty to skip real emails: they are written to the API log instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HerHandmade <no-reply@your-domain.org>

# Shown to businesses on the tracking page
NGO_NAME=HerHandmade
NGO_EMAIL=hello@your-domain.org
NGO_PHONE=+91-9000000000
